# Way2Skills - Environment Variables Template
# Copy this file to frontend/.env.local:
#   cp .env.example frontend/.env.local

# Google Apps Script Web App endpoint for contact and admission form submissions
# Replace with your deployed Web App URL (ending in /exec)
NEXT_PUBLIC_WAY2SKILLS_APPS_SCRIPT_WEB_APP_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"
