# PostgreSQL container credentials
POSTGRES_USER=way2skills
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=way2skills

# Backend connection to the PostgreSQL service inside Docker Compose.
# Keep the username, password, and database consistent with the values above.
# URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://way2skills:replace-with-a-strong-password@db:5432/way2skills

# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=30
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENV=development

# This URL is embedded in the frontend image at build time and must be
# reachable from the user's browser, not just from another Compose container.
NEXT_PUBLIC_WAY2SKILLS_API_URL=http://localhost:8000
